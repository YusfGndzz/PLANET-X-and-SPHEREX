def create_http_session() -> requests.Session:
    session = requests.Session()
    retry = Retry(
        total=5,
        backoff_factor=1.5,
        status_forcelist=[429, 500, 502, 503, 504],
        allowed_methods=["GET", "POST"],
    )
    adapter = HTTPAdapter(max_retries=retry, pool_connections=4, pool_maxsize=4)
    session.mount("https://", adapter)
    session.mount("http://", adapter)
    return session


def mjd_to_date(mjd: float) -> str:
    return (datetime(1858, 11, 17) + timedelta(days=float(mjd))).strftime("%Y-%m-%d")


def angular_sep_deg(ra1: np.ndarray, dec1: np.ndarray, ra2: float, dec2: float) -> np.ndarray:
    r1, d1 = np.deg2rad(ra1), np.deg2rad(dec1)
    r2, d2 = np.deg2rad(ra2), np.deg2rad(dec2)
    cos_a = np.sin(d1) * np.sin(d2) + np.cos(d1) * np.cos(d2) * np.cos(r1 - r2)
    return np.rad2deg(np.arccos(np.clip(cos_a, -1.0, 1.0)))


def point_in_s_region(ra_deg: float, dec_deg: float, s_region: str) -> bool:
    if not s_region:
        return True
    nums = [float(x) for x in re.findall(r"[-+]?\d*\.\d+|[-+]?\d+", str(s_region))]
    if len(nums) < 6 or len(nums) % 2 != 0:
        return True

    ra_v = np.deg2rad(nums[0::2])
    dec_v = np.deg2rad(nums[1::2])
    ra0, dec0 = np.deg2rad(ra_deg), np.deg2rad(dec_deg)

    cos_c = np.sin(dec0) * np.sin(dec_v) + np.cos(dec0) * np.cos(dec_v) * np.cos(ra_v - ra0)
    if np.any(cos_c <= 0):
        return False

    x = (np.cos(dec_v) * np.sin(ra_v - ra0)) / cos_c
    y = (np.cos(dec0) * np.sin(dec_v) - np.sin(dec0) * np.cos(dec_v) * np.cos(ra_v - ra0)) / cos_c

    inside = False
    j = len(x) - 1
    for i in range(len(x)):
        if ((y[i] > 0) != (y[j] > 0)) and (0 < (x[j] - x[i]) * (-y[i]) / (y[j] - y[i] + 1e-15) + x[i]):
            inside = not inside
        j = i
    return inside


def parse_user_target() -> tuple[SkyCoord, str, float, float, int]:
    print("=== SPHEREx Hızlı Görüntü & GIF İndirici ===")
    first_input = input("Hedef Adı veya RA (örn: R Draconis veya 133.7951): ").strip()
    if not first_input:
        raise ValueError("Lütfen bir hedef adı veya RA değeri girin.")

    is_coordinate = bool(re.match(r"^[0-9+\-.:hmsd\s]+$", first_input, re.IGNORECASE))
    if is_coordinate:
        dec_input = input("Dec koordinatı (örn: -07d14m42.53s veya -7.2451): ").strip()
        try:
            coord = SkyCoord(ra=float(first_input) * u.deg, dec=float(dec_input) * u.deg, frame="icrs")
        except ValueError:
            coord = SkyCoord(first_input, dec_input, unit=(u.hourangle, u.deg), frame="icrs")
        base_name = f"spherex_ra{coord.ra.deg:.2f}_dec{coord.dec.deg:.2f}"
    else:
        print(f"'{first_input}' koordinatları bulunuyor...")
        coord = SkyCoord.from_name(first_input)
        clean_name = re.sub(r"[^a-zA-Z0-9_-]+", "_", first_input.lower()).strip("_")
        base_name = f"spherex_{clean_name}"

    fov_raw = input("Görüş alanı / FOV yay-dakikası (varsayılan 4.0 için Enter): ").strip()
    fov_arcmin = float(fov_raw) if fov_raw else 4.0

    band_raw = input("Dalga boyu mikrometre (varsayılan 2.5 için Enter): ").strip()
    band_um = float(band_raw) if band_raw else 2.5

    frames_raw = input("Kaç adet görüntü indirilsin? (varsayılan 12 için Enter): ").strip()
    max_frames = int(frames_raw) if frames_raw else 12

    return coord, base_name, fov_arcmin, band_um, max_frames


def resolve_fits_url(access_url: str, access_format: str, session: requests.Session) -> str | None:
    if "datalink" not in (access_format or "").lower():
        return access_url

    resp = session.get(access_url, timeout=25)
    resp.raise_for_status()
    root = ET.fromstring(resp.content)

    fields = [el.attrib.get("name", "") for el in root.iter() if el.tag.endswith("FIELD")]
    if "access_url" not in fields or "semantics" not in fields:
        return None

    url_idx = fields.index("access_url")
    sem_idx = fields.index("semantics")

    for tr in root.iter():
        if tr.tag.endswith("TR"):
            tds = [td.text or "" for td in tr if td.tag.endswith("TD")]
            if len(tds) > max(url_idx, sem_idx) and "#this" in tds[sem_idx]:
                return tds[url_idx].strip()
    return None


def download_epoch_image(
    obs_date: str,
    candidates: list[dict],
    coord: SkyCoord,
    fov_arcmin: float,
    session: requests.Session,
) -> tuple[float, Image.Image, str, float] | None:
    """Aynı tarihteki aday pozları sırayla dener; biri 503/422 verirse diğerine geçer."""
    for row in candidates:
        try:
            time.sleep(0.35)
            fits_url = resolve_fits_url(row["access_url"], row["access_format"], session)
            if not fits_url:
                continue

            base_deg = fov_arcmin / 60.0
            sep = "&" if "?" in fits_url else "?"
            resp = None

            for scale in (1.45, 1.0):
                size_deg = base_deg * scale
                cutout_url = (
                    f"{fits_url}{sep}center={coord.ra.deg:.6f},{coord.dec.deg:.6f}"
                    f"&size={size_deg:.6f}"
                )
                r = session.get(cutout_url, timeout=45)
                if r.status_code == 422:
                    continue
                r.raise_for_status()
                resp = r
                break

            if resp is None:
                continue

            mb = len(resp.content) / (1024.0 * 1024.0)

            with fits.open(io.BytesIO(resp.content)) as hdul:
                img_hdu = hdul["IMAGE"] if "IMAGE" in hdul else next(
                    (h for h in hdul if h.data is not None and h.data.ndim == 2), None
                )
                if img_hdu is None:
                    continue

                wcs = WCS(img_hdu.header)
                if not wcs.footprint_contains(coord):
                    continue

                cutout = Cutout2D(
                    img_hdu.data,
                    position=coord,
                    size=fov_arcmin * u.arcmin,
                    wcs=wcs,
                    mode="partial",
                    fill_value=np.nan,
                )

                data = cutout.data
                if np.isnan(data).mean() > 0.60:
                    continue

                clean_data = np.nan_to_num(data, nan=np.nanmedian(data))

                vmin, vmax = np.nanpercentile(clean_data, [5.0, 99.5])
                if vmax <= vmin:
                    vmax = vmin + 1e-6
                normed = np.clip((clean_data - vmin) / (vmax - vmin), 0.0, 1.0)
                stretched = np.arcsinh(normed * 10.0) / np.arcsinh(10.0)
                uint8_img = np.flipud((stretched * 255.0).astype(np.uint8))

                pil_img = Image.fromarray(uint8_img).convert("RGB")
                pil_img = pil_img.resize((400, 400), resample=Image.Resampling.NEAREST)

                wavelength = row["em_min"] * 1e6
                label = f"{obs_date} | {wavelength:.2f} um"

                draw = ImageDraw.Draw(pil_img)
                draw.rectangle([(5, 5), (235, 32)], fill=(0, 0, 0))
                draw.text((10, 12), label, fill=(255, 230, 100))

                return row["t_min"], pil_img, label, mb

        except requests.exceptions.RequestException:
            # Sunucu geçici 503 döndürdüyse aynı günün ikinci aday pozuna geç
            continue
        except Exception:
            continue

    return None


def run():
    coord, base_name, fov_arcmin, band_um, max_frames = parse_user_target()
    ra_deg, dec_deg = coord.ra.deg, coord.dec.deg
    min_m = (band_um - 0.25) * 1e-6
    max_m = (band_um + 0.25) * 1e-6

    adql_query = f"""
    SELECT TOP 1500
        obs_id, t_min, em_min, s_ra, s_dec, s_region, access_url, access_format
    FROM spherex.obscore
    WHERE CONTAINS(POINT('ICRS', s_ra, s_dec), CIRCLE('ICRS', {ra_deg:.6f}, {dec_deg:.6f}, 1.85)) = 1
      AND dataproduct_type = 'image'
      AND em_min >= {min_m:.9f}
      AND em_min <= {max_m:.9f}
    """

    session = create_http_session()
    print(f"\nNASA IRSA katalog sorgulanıyor (RA={ra_deg:.4f}°, Dec={dec_deg:.4f}°)...")

    tap_resp = session.post(
        "https://irsa.ipac.caltech.edu/TAP/sync",
        data={"REQUEST": "doQuery", "LANG": "ADQL", "FORMAT": "csv", "QUERY": adql_query},
        timeout=30,
    )
    tap_resp.raise_for_status()

    raw_rows = list(csv.DictReader(io.StringIO(tap_resp.text)))
    if not raw_rows or "obs_id" not in raw_rows[0]:
        print("Bu koordinatta SPHEREx görüntüsü bulunamadı.")
        return

    valid_rows = []
    for r in raw_rows:
        if point_in_s_region(ra_deg, dec_deg, r.get("s_region", "")):
            valid_rows.append({
                "obs_id": r["obs_id"],
                "t_min": float(r["t_min"]),
                "em_min": float(r["em_min"]),
                "s_ra": float(r["s_ra"]),
                "s_dec": float(r["s_dec"]),
                "access_url": r["access_url"],
                "access_format": r["access_format"],
                "obs_date": mjd_to_date(float(r["t_min"])),
            })

    if not valid_rows:
        print("Hedefi tam kapsayan çekim bulunamadı.")
        return

    seps = angular_sep_deg(
        np.array([x["s_ra"] for x in valid_rows]),
        np.array([x["s_dec"] for x in valid_rows]),
        ra_deg,
        dec_deg,
    )
    candidates_by_date: dict[str, list[dict]] = {}
    for row, sep in zip(valid_rows, seps):
        row["sep"] = float(sep)
        candidates_by_date.setdefault(row["obs_date"], []).append(row)

    for d in candidates_by_date:
        candidates_by_date[d].sort(key=lambda x: x["sep"])
        candidates_by_date[d] = candidates_by_date[d][:2]

    sorted_dates = sorted(candidates_by_date.keys())
    print(f"{len(sorted_dates)} farklı tarih bulundu. {min(len(sorted_dates), max_frames)} görüntü indiriliyor...")

    results = []
    tested_dates = set()
    total_mb = 0.0
    max_attempts = min(len(sorted_dates), max_frames + 4)

    with ThreadPoolExecutor(max_workers=2) as executor:
        while len(results) < max_frames and len(tested_dates) < max_attempts:
            remaining_dates = [d for d in sorted_dates if d not in tested_dates]
            needed = min(max_frames - len(results), max_attempts - len(tested_dates))
            if needed <= 0 or not remaining_dates:
                break

            indices = np.linspace(0, len(remaining_dates) - 1, needed, dtype=int)
            batch_dates = [remaining_dates[i] for i in indices]
            tested_dates.update(batch_dates)

            futures = [
                executor.submit(
                    download_epoch_image, d, candidates_by_date[d], coord, fov_arcmin, session
                )
                for d in batch_dates
            ]
            for future in futures:
                res = future.result()
                if res is not None:
                    t_min, pil_img, label, mb = res
                    total_mb += mb
                    results.append((t_min, pil_img, label))
                    print(f"  İndi ({mb:.1f} MB): {label}")

    session.close()
    results.sort(key=lambda x: x[0])

    if not results:
        print("Görüntü indirilemedi.")
        return

    img_folder = f"{base_name}_kareler"
    os.makedirs(img_folder, exist_ok=True)
    for idx, (_, pil_img, label) in enumerate(results, start=1):
        date_part = label.split(" | ")[0]
        pil_img.save(os.path.join(img_folder, f"{idx:02d}_{date_part}.png"))

    frames = [item[1] for item in results]
    output_gif = f"{base_name}.gif"
    if len(frames) >= 2:
        frames[0].save(
            output_gif,
            save_all=True,
            append_images=frames[1:],
            duration=550,
            loop=0,
        )

    print(f"\nBitti! Toplam veri: {total_mb:.1f} MB")
    print(f"- Tek tek PNG görüntüler: ./{img_folder}/")
    if len(frames) >= 2:
        print(f"- GIF animasyonu: ./{output_gif}")


if __name__ == "__main__":
    run()
